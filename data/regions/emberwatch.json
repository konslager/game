  "region": {
    "id": "emberwatch_march",
    "name": "Emberwatch March",
    "levelRange": [1, 11],
    "zoneIds": [1, 2],
    "description": "Pasienio regionas prie Plyšio (the Rift). Prieš 40 metų dangus čia suskilo, ir nuo tada be paliovos krenta pelenai. Gyvenvietė Emberwatch – paskutinė tvirtovė prieš Ashen Outskirts dykynes ir Shattered Rift plyšį."
  },

  "settlement": {
    "id": "emberwatch",
    "name": "Emberwatch",
    "type": "frontier_fortress_town",
    "population": 3200,
    "faction": "emberwatch_garrison",
    "atmosphere": "Tamsi pasienio tvirtovė ant senojo sargybos bokšto griuvėsių. Stogai pilki nuo pelenų, gatvėse dega žarijų žibintai, o naktį Plyšys nušviečia dangų violetine šviesa. Gyventojai pavargę, bet atkaklūs: čia visi kažkam skolingi – garnizonui, kalviui ar kontrabandininkams.",
    "ambience": { "weather": "ash_fall", "music": "low_drums_strings", "dayNightCycle": true },
    "respawnPoint": "gatehold_square"
  },

  "districts": [
    {
      "id": "gatehold_square",
      "name": "Gatehold Square",
      "type": "market",
      "safeZone": true,
      "description": "Pagrindinė turgaus aikštė prie vartų. Čia stovi užduočių lenta, vaistinė ir karavanų stovykla.",
